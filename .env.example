# ============================================================
# AgriMarket — variables d'environnement (exemple)
# Copie ce fichier en .env et remplis les valeurs.
# ============================================================

# Base de données PostgreSQL (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/agrimarket?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="change-moi-par-une-chaine-aleatoire-32+"
AUTH_URL="http://localhost:3000"

# Fournisseurs OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OTP téléphone (ex. Termii / Twilio)
SMS_PROVIDER_API_KEY=""
SMS_SENDER_ID="AgriMarket"

# E-mail (Resend). Si vide, les e-mails sont affichés dans la console (dev).
RESEND_API_KEY=""
EMAIL_FROM="AgriMarket <no-reply@agrimarket.bj>"

# Stockage images (Cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Paiements — couche d'abstraction (adaptateurs)
MTN_MOMO_API_KEY=""
MOOV_MONEY_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY="XOF"
